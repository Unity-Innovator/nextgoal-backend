# Copy this file to /etc/default/nextgoal-env on the Ubuntu server and replace
# every replace-me value. The DB_* and SPRING_DATASOURCE_* credentials must
# contain the same username and password for the legacy Compose deployment.
POSTGRES_DB=nextgoal
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/nextgoal
SPRING_DATASOURCE_USERNAME=replace-me
SPRING_DATASOURCE_PASSWORD=replace-me

# Generate a cryptographically random value containing at least 32 UTF-8 bytes.
JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Use a separate random secret of at least 32 bytes for OTP hashing.
OTP_SECRET=replace-me-with-at-least-32-random-bytes
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-me-with-random-redis-password
PLASGATE_BASE_URL=https://cloudapi.plasgate.com
PLASGATE_PRIVATE_KEY=replace-me
PLASGATE_SECRET_KEY=replace-me
PLASGATE_SENDER=replace-me

# Supabase Storage: use a private bucket and a server-only sb_secret_ key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_STORAGE_BUCKET=chat-attachments

SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGIN_PATTERNS=https://replace-me.example
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://replace-me.example
TEST_USER_SEED_ENABLED=false

# Shared Redis response cache (ISO-8601 duration).
BACKEND_CACHE_ENABLED=true
ASSISTANT_CACHE_TTL=PT2M
