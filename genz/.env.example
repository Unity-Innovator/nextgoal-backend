# Copy this file to /etc/default/nextgoal-env on the Ubuntu server and replace
# every replace-me value. BACKEND_IMAGE is supplied by GitLab CI at deploy time.
POSTGRES_IMAGE=postgres:17@sha256:replace-me-with-the-pinned-image-digest
POSTGRES_VOLUME_NAME=replace-me-with-the-existing-docker-volume-name
POSTGRES_DB=nextgoal
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/nextgoal
SPRING_DATASOURCE_USERNAME=replace-me
SPRING_DATASOURCE_PASSWORD=replace-me

# Generate a cryptographically random value containing at least 32 UTF-8 bytes.
JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGIN_PATTERNS=https://replace-me.example
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://replace-me.example
OTP_CONSOLE_DELIVERY_ENABLED=false
TEST_USER_SEED_ENABLED=false
